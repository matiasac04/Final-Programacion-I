<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!--
            Cadena de conexión a la base de datos.
            Esta versión del archivo NO lleva la clave: es la que se sube al repo.
            Para correr en tu máquina: copiá 'App.config.local.example' a
            'App.config.local', completá la clave ahí y NO subas ese archivo.
        -->
        <add key="CadenaConexion" value="Data Source=.\SQLEXPRESS;Initial Catalog=comercio;User ID=sa;Password=" />

        <!--
            Carpeta donde se guardan los respaldos (.bak).
            Vacío = la carpeta de backup por defecto de la instancia de SQL Server.
        -->
        <add key="CarpetaBackup" value="" />
    </appSettings>
</configuration>
